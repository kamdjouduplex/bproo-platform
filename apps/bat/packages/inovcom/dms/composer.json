{
    "name": "inovcom/dms",
    "description": "BPROO ERP Document Management System: file upload, versioning, polymorphic attachments",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Dms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Dms\\DmsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
