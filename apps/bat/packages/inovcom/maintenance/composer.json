{
    "name": "inovcom/maintenance",
    "description": "BPROO ERP Maintenance module: contracts, orders, interventions, SLA tracking",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/clients": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Maintenance\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Maintenance\\MaintenanceServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
