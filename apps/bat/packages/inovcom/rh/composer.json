{
    "name": "inovcom/rh",
    "description": "InovCom ERP HR module: employees, payroll, payslips, leave management",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Rh\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Rh\\RhServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
