{
    "name": "inovcom/stock",
    "description": "InovCom ERP Stock module: movement-based inventory management, products, warehouses.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Stock\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Stock\\StockServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
