        "nunomaduro/collision": "^7.0",
        "phpunit/phpunit": "^10.1"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "App\\Models\\": "app/Models/",
            "App\\Services\\": "app/Services/",
            "App\\Http\\Middleware\\": "app/Http/Middleware/",
            "App\\Http\\Controllers\\": "app/Http/Controllers/",
            "App\\Jobs\\": "app/Jobs/",
            "App\\Livewire\\": "app/Livewire/",
            "App\\Support\\": "app/Support/",
            "App\\Events\\": "app/Events/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/",
            "InovCom\\Kernel\\": "../../packages/inovcom/core/src/",
            "InovCom\\Items\\": "../../packages/inovcom/items/src/",
            "InovCom\\Users\\": "../../packages/inovcom/users/src/",
            "InovCom\\Clients\\": "../../packages/inovcom/crm/src/",
            "InovCom\\Providers\\": "../../packages/inovcom/providers/src/",
            "InovCom\\Expenses\\": "../../packages/inovcom/expenses/src/",
            "InovCom\\Inventory\\": "../../packages/inovcom/inventory-count/src/",
            "InovCom\\Debts\\": "../../packages/inovcom/debts/src/",
            "InovCom\\Losses\\": "../../packages/inovcom/losses/src/",
            "InovCom\\Purchases\\": "../../packages/inovcom/purchases/src/",
            "InovCom\\Sales\\": "../../packages/inovcom/sales/src/",
            "InovCom\\Stock\\": "../../packages/inovcom/inventory/src/",
            "InovCom\\Reporting\\": "../../packages/inovcom/reporting/src/",
            "InovCom\\Payroll\\": "../../packages/inovcom/hr/src/",
            "InovCom\\Attendance\\": "../../packages/inovcom/attendance/src/",
            "InovCom\\Configuration\\": "../../packages/inovcom/configuration/src/",
            "InovCom\\Batches\\": "../../packages/inovcom/batches/src/",
            "InovCom\\Prescriptions\\": "../../packages/inovcom/prescriptions/src/",
            "InovCom\\Caisse\\": "../../packages/inovcom/cash-register/src/",
            "InovCom\\Quotations\\": "../../packages/inovcom/quotations/src/",
            "InovCom\\Invoicing\\": "../../packages/inovcom/invoicing/src/",
            "InovCom\\InvoicePayments\\": "../../packages/inovcom/payments/src/",
            "InovCom\\Tickets\\": "../../packages/inovcom/tickets/src/",
            "InovCom\\Returns\\": "../../packages/inovcom/returns/src/",
            "InovCom\\Reservations\\": "../../packages/inovcom/reservations/src/",
            "InovCom\\Prospects\\": "../../packages/inovcom/prospects/src/",
            "InovCom\\Branding\\": "../../packages/inovcom/settings/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
