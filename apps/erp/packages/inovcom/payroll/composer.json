{
    "name": "inovcom/payroll",
    "description": "Inov-Com Payroll module: employee payroll management",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Payroll\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Payroll\\PayrollServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
