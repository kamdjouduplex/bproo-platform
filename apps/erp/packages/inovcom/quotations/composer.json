{
    "name": "inovcom/quotations",
    "description": "Inov-Com Quotations module: devis clients avec workflow de validation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/clients": "@dev",
        "inovcom/items": "@dev",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Quotations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Quotations\\QuotationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
