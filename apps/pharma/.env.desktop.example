# Copy to .env for stand-alone desktop installs (Phase 4).
# Do NOT use this for multi-tenant SaaS hosting.

APP_NAME="Bproo Pharma Desktop"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8003
APP_PRODUCT_KEY=pharma
APP_VERSION=0.1.0

DESKTOP_RUNTIME=1
CONTROL_CENTER_URL=http://127.0.0.1:8010
DESKTOP_UPDATE_CHANNEL=stable
DESKTOP_APP_VERSION=0.1.0
DESKTOP_SYNC_BATCH_SIZE=50
DESKTOP_HEALTHCHECK="php artisan about"

# Single-tenant local DB (SQLite recommended for shops)
DB_CONNECTION=sqlite
# DB_DATABASE will be set by install.ps1 to an absolute path

SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
LOG_CHANNEL=stack
