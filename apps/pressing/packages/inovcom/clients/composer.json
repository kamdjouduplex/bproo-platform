{
    "name": "inovcom/clients",
    "description": "Inov-Com Clients module: client management, segments, credit limits, addresses, contacts",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Clients\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Clients\\ClientsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
