{
    "name": "inovcom/configuration",
    "description": "Inov-Com Configuration: tenant system settings",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Configuration\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Configuration\\ConfigurationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
