{
    "name": "inovcom/inventory",
    "description": "Inov-Com Inventory module: stock counts, adjustments, and inventory management even when store is operational",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Inventory\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Inventory\\InventoryServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
