{
    "name": "inovcom/invoice-payments",
    "description": "Inov-Com Invoice Payments module: suivi des paiements sur factures",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/invoicing": "@dev",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\InvoicePayments\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\InvoicePayments\\InvoicePaymentsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
