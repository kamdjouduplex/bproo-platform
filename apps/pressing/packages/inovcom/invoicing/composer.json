{
    "name": "inovcom/invoicing",
    "description": "Inov-Com Invoicing module: factures avec et sans déclaration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/clients": "@dev",
        "inovcom/items": "@dev",
        "inovcom/kernel": "@dev",
        "inovcom/quotations": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Invoicing\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Invoicing\\InvoicingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
