{
    "name": "inovcom/reporting",
    "description": "Inov-Com Reporting module: reports and analytics (benefit, expenses, losses, top products)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Reporting\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Reporting\\ReportingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
