{
    "name": "inovcom/returns",
    "description": "Inov-Com Returns module: retours clients, avoirs, remboursements, crédits clients et échanges",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/clients": "@dev",
        "inovcom/items": "@dev",
        "inovcom/kernel": "@dev",
        "inovcom/invoicing": "@dev",
        "inovcom/stock": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Returns\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Returns\\ReturnsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
