{
    "name": "bproo/crm-suite",
    "description": "Tenant CRM workspace: prospects, opportunities, activities (installable in any product app). Distinct from Control Center landlord Relation client.",
    "type": "library",
    "license": "MIT",
    "version": "1.0.0",
    "require": {
        "php": "^8.1",
        "bproo/core": "@dev",
        "bproo/crm": "@dev",
        "bproo/prospects": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Crm\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Crm\\CrmServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
