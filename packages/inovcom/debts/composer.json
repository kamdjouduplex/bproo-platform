{
    "name": "inovcom/debts",
    "description": "Inov-Com Debts module: client debts, payments and repayment schedules",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/clients": "@dev",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Debts\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Debts\\DebtsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
