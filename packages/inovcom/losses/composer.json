{
    "name": "inovcom/losses",
    "description": "Inov-Com Losses module: loss records, reasons, and stock integration",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/items": "@dev",
        "inovcom/kernel": "@dev",
        "inovcom/stock": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Losses\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Losses\\LossesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
