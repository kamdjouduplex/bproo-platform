{
    "name": "inovcom/prospects",
    "description": "Inov-Com Prospects module: lead tracking and conversion to clients",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/clients": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Prospects\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Prospects\\ProspectsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
