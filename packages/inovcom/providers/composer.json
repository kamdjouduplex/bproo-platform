{
    "name": "inovcom/providers",
    "description": "Inov-Com Providers module: supplier management for African market",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Providers\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Providers\\ProvidersServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
