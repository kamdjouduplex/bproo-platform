{
    "name": "inovcom/purchases",
    "description": "Inov-Com Purchases module: purchase orders and receipts for African market",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/items": "@dev",
        "inovcom/providers": "@dev",
        "inovcom/stock": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Purchases\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Purchases\\PurchasesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
