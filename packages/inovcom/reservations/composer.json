{
    "name": "inovcom/reservations",
    "description": "Inov-Com Reservations module: client product holds with stock reservation",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/clients": "@dev",
        "inovcom/items": "@dev",
        "inovcom/kernel": "@dev",
        "inovcom/stock": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Reservations\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Reservations\\ReservationsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
