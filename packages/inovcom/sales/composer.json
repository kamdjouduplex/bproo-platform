{
    "name": "inovcom/sales",
    "description": "Inov-Com Sales module: POS sales management for African market",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/items": "@dev",
        "inovcom/clients": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Sales\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Sales\\SalesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
