{
    "name": "inovcom/stock",
    "description": "Inov-Com Stock module: inventory management for African market",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/items": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Stock\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Stock\\StockServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
