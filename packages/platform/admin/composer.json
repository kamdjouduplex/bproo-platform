{
    "name": "bproo/platform-admin",
    "description": "Bproo platform Admin Livewire suite",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Http\\Controllers\\Admin\\": "src/Http/Controllers/Admin/",
            "App\\Livewire\\Admin\\": "src/Livewire/Admin/",
            "Bproo\\Platform\\Admin\\": "src/Platform/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bproo\\Platform\\Admin\\AdminServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
