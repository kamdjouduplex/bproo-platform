{
    "name": "bproo/platform-billing",
    "description": "Bproo platform plans, subscriptions, payments",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Models\\": "src/Models/",
            "App\\Services\\": "src/Services/",
            "Bproo\\Platform\\Billing\\": "src/Platform/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bproo\\Platform\\Billing\\BillingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
