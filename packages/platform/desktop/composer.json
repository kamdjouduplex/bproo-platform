{
    "name": "bproo/platform-desktop",
    "description": "Bproo desktop runtime agent (licence, updates, OUT sync outbox)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0",
        "illuminate/console": "^10.0",
        "illuminate/http": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Bproo\\Platform\\Desktop\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bproo\\Platform\\Desktop\\DesktopServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
