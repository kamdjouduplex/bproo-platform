{
    "name": "bproo/platform-modules",
    "description": "Bproo platform module registry and lifecycle",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Events\\": "src/Events/",
            "App\\Http\\Middleware\\": "src/Http/Middleware/",
            "App\\Jobs\\": "src/Jobs/",
            "App\\Models\\": "src/Models/",
            "App\\Services\\": "src/Services/",
            "Bproo\\Platform\\Modules\\": "src/Platform/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bproo\\Platform\\Modules\\ModulesServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
