{
    "name": "bproo/platform-printing",
    "description": "Bproo platform print/PDF helpers",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Support\\": "src/Support/",
            "Bproo\\Platform\\Printing\\": "src/Platform/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bproo\\Platform\\Printing\\PrintingServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
