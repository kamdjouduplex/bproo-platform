{
    "name": "bproo/platform-tenancy",
    "description": "Bproo platform tenancy (company/tenant runtime)",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0",
        "illuminate/database": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\Http\\Middleware\\": "src/Http/Middleware/",
            "App\\Jobs\\": "src/Jobs/",
            "App\\Models\\": "src/Models/",
            "App\\Services\\": "src/Services/",
            "App\\Support\\": "src/Support/",
            "Bproo\\Platform\\Tenancy\\": "src/Platform/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bproo\\Platform\\Tenancy\\TenancyServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
