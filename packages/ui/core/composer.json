{
  "name": "bproo/ui-core",
  "description": "Shared UI kit (Blade anonymous components) for platform apps.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Bproo\\UiCore\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Bproo\\UiCore\\UiCoreServiceProvider"
      ]
    }
  },
  "minimum-stability": "stable"
}
