{
    "name": "inovcom/facturation",
    "description": "BPROO ERP Facturation module: invoices, lines, payment tracking",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bproo/core": "@dev",
        "inovcom/clients": "@dev",
        "inovcom/devis": "@dev",
        "inovcom/projets": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Facturation\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Facturation\\FacturationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
