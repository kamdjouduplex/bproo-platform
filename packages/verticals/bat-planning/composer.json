{
    "name": "inovcom/planning",
    "description": "BPROO ERP Planning module: appointments, site visits, project milestones, technician scheduling",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/clients": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Planning\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Planning\\PlanningServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
