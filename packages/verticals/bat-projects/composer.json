{
    "name": "inovcom/projets",
    "description": "BPROO ERP Projets module: projects from accepted quotes, team and deadlines",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "inovcom/kernel": "@dev",
        "inovcom/clients": "@dev",
        "inovcom/offres": "@dev",
        "inovcom/devis": "@dev",
        "inovcom/users": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "InovCom\\Projets\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InovCom\\Projets\\ProjetsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable"
}
