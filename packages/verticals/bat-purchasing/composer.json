{
    "name": "inovcom/achats",
    "description": "BPROO ERP Achats module: bons d'achat, fournisseurs, validation, suivi livraisons",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "bproo/core": "@dev",
        "inovcom/clients": "@dev",
        "inovcom/projets": "@dev",
        "laravel/framework": "^10.0",
        "livewire/livewire": "^3.0|^4.0"
    },
    "autoload": {
