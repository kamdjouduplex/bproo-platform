{
  "name": "bproo/school",
  "description": "Bproo School vertical: school ERP hub + domain modules (academic years, students, cards, payments).",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "livewire/livewire": "^3.0|^4.0"
  },
  "autoload": {
    "psr-4": {
      "School\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "School\\SchoolServiceProvider"
      ]
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}

